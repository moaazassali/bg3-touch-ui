<!-- Touch UI - Reusable context menu + tooltip sheet in a single popup so the tooltip can never cover the menu.
     Two pieces in this file:
     - TouchUI_ContextMenuWithTooltip (ContentControl template): the top-level component an area places in
       its own template. The area passes the data contract to it and it renders the anchor element that
       hosts the engine context menu:
         Content                     -> the item the menu + tooltip operate on (e.g. SelectedItem.Object)
         Tag                         -> the multi-select source collection (e.g. SelectedItems)
         ls:TooltipExtender.Owner    -> character owning the tooltip
         ls:TooltipExtender.PlayerId -> player id
         ls:TooltipExtender.Context  -> context string ("Inventory", "Equipment", ...)
     - TouchUI_ContextMenuWithTooltipPopup (ls:ContextMenu template): the popup itself. Column 0 holds the
       engine's action buttons (injected via ContextMenuFillBehavior / ContextActionMenuFill); the background
       DefaultTooltip9Slice frame is drawn at 1x (MenuFrameLayer LayoutTransform 0.5 + 2x size bindings)
       while the buttons stay at the engine's 2x. Column 1 holds the item tooltip sheet generated by
       ls:TooltipExtender. The engine never looks at the menu's visuals, only at the Items collection.
     The popup is positioned via Placement=Relative + an offset against the widget width, so it hugs the
     right edge regardless of the anchor element. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
                    xmlns:ls="clr-namespace:ls;assembly=Code"
                    xmlns:System="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <ControlTemplate x:Key="TouchUI_ContextMenuWithTooltipPopup" TargetType="ls:ContextMenu">
        <Popup x:Name="MenuPopup" Placement="Relative" HorizontalOffset="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}, Converter={StaticResource MultiplierConverter}, ConverterParameter=0.78}" VerticalOffset="0" IsOpen="{TemplateBinding IsOpen}" StaysOpen="True" AllowsTransparency="True">
            <Grid VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- col 0: context menu engine entries -->
                    <ColumnDefinition Width="Auto"/> <!-- col 1: tooltip sheet -->
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" x:Name="MenuHost" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid x:Name="MenuFrameLayer"
                        Width="{Binding ActualWidth, ElementName=MenuItemsPresenter, Converter={StaticResource MultiplierConverter}, ConverterParameter=2}"
                        Height="{Binding ActualHeight, ElementName=MenuItemsPresenter, Converter={StaticResource MultiplierConverter}, ConverterParameter=2}"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                        </Grid.LayoutTransform>
                        <ls:LSNineSliceImage Style="{DynamicResource DefaultTooltip9Slice}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                    <ScrollViewer x:Name="MenuItemsPresenter" Padding="10,20"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Grid>

                <ContentControl x:Name="TooltipBox" Grid.Column="1" Margin="0,0,0,0" VerticalAlignment="Stretch"
                    ls:TooltipExtender.Content="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                    ls:TooltipExtender.Data="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                    ls:TooltipExtender.IsOpen="True"
                    ls:TooltipExtender.Owner="{Binding DataContext.CurrentPlayer.SelectedCharacter, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                    ls:TooltipExtender.PlayerId="{Binding DataContext.CurrentPlayer.PlayerId, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                    ls:TooltipExtender.Context="{Binding (ls:TooltipExtender.Context), RelativeSource={RelativeSource TemplatedParent}}"
                    Content="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}">
                    <ContentControl.LayoutTransform>
                        <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                    </ContentControl.LayoutTransform>
                </ContentControl>
            </Grid>
        </Popup>
        <ControlTemplate.Triggers>
            <Trigger SourceName="MenuPopup" Property="IsOpen" Value="False">
                <Setter TargetName="TooltipBox" Property="Content" Value="{x:Null}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="TouchUI_ContextMenuWithTooltip" TargetType="ContentControl">
        <ls:LSEntityObject
            Context="{Binding (ls:TooltipExtender.Context), RelativeSource={RelativeSource TemplatedParent}}"
            EntityRef="{Binding Content.EntityHandle, RelativeSource={RelativeSource TemplatedParent}}"
            DataContext="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
            ls:ContextMenuService.GenerateEnabled="False"
            ls:TooltipExtender.Owner="{Binding (ls:TooltipExtender.Owner), RelativeSource={RelativeSource TemplatedParent}}"
            ls:TooltipExtender.PlayerId="{Binding (ls:TooltipExtender.PlayerId), RelativeSource={RelativeSource TemplatedParent}}"
            HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Background="{x:Null}">
            <b:Interaction.Behaviors>
                <ls:ContextMenuFillBehavior Context="{Binding (ls:TooltipExtender.Context), RelativeSource={RelativeSource TemplatedParent}}" Player="{Binding DataContext.CurrentPlayer, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" TargetObject="{Binding .}" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FillCommand="{Binding DataContext.ContextActionMenuFill, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"/>
            </b:Interaction.Behaviors>
            <ls:LSEntityObject.ContextMenu>
                <ls:ContextMenu Style="{StaticResource BaseLSContextMenu}" Template="{StaticResource TouchUI_ContextMenuWithTooltipPopup}"/>
            </ls:LSEntityObject.ContextMenu>
        </ls:LSEntityObject>
    </ControlTemplate>

</ResourceDictionary>