<!-- Copied from Game\Public\Game\GUI\Library\SaveLoad.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:System="clr-namespace:System;assembly=mscorlib"
                    xmlns:ls="clr-namespace:ls;assembly=Code"
                    xmlns:data="clr-namespace:System.Data;assembly=System.Data"
                    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <!-- Some things cannot be found without import the parent file -->
        <ResourceDictionary Source="/Core;component/Library/SaveLoad.xaml"/>
        <!-- Touch UI - Import our custom files -->
        <ResourceDictionary Source="TouchUI_SaveInformationTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="TouchUI_SavePresenterTemplate">
        <DockPanel Visibility="{Binding SelectedSave, Converter={StaticResource NullToHiddenConverter}}" Margin="60,0,100,0">
            <!-- <TextBlock DockPanel.Dock="Top" Text="{Binding Source='h43359aecg77b3g49d0g9632g18a79d3e0bbd', Converter={StaticResource TranslatedStringConverter}}" Foreground="{StaticResource LS_tint100}" FontSize="{StaticResource ScaledTitleFontSize}" HorizontalAlignment="Center"/> -->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" x:Name="ScreenshotHolder" HorizontalAlignment="Center" Margin="30,0,0,0" VerticalAlignment="Stretch">
                    <Rectangle Fill="{Binding SelectedScreenshot}" Margin="30,40"/>
                    <Image Source="{StaticResource ScreenshotHolder}" Stretch="Fill"/>
                </Grid>

                
                <Grid Grid.Column="1" x:Name="TextDescriptions" Margin="0,0,0,0" HorizontalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                    </Grid.LayoutTransform>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" x:Name="SaveType" Text="{Binding Source='hc41b7af0g94d7g4e1ag979cg904a9146c941', Converter={StaticResource TranslatedStringConverter}}" Style="{StaticResource SavefileInfo.Title}" FontSize="{StaticResource ScaledLargeFontSize}"/>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" x:Name="RegionName" Text="{Binding SelectedSave.LevelName}" Style="{StaticResource SavefileInfo.Value}" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontSize="{StaticResource ScaledTitleFontSize}" TextWrapping="Wrap" TextAlignment="Center"/>

                    <Control Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Template="{StaticResource TouchUI_SaveInformationTemplate}" DataContext="{Binding SelectedSave}" Margin="0,0,0,0"/>

                    <Image Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" x:Name="CrossIcon" Source="{StaticResource CrossImage}" Stretch="None" VerticalAlignment="Center" Margin="47,0,0,0"/>
                    <TextBlock Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" x:Name="CrossTitle" Text="{Binding Source='hd9a78783g7021g4e8dga770g11c966ce5262', Converter={StaticResource TranslatedStringConverter}}" Style="{StaticResource SavefileInfo.Title}" FontSize="{StaticResource ScaledMediumFontSize}" Margin="5,0,0,0"/>
                    <TextBlock Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Left" x:Name="CrossSaveStatus" Text="{Binding Source='hb20007ddg7ba5g4432ga01eg42b1f30c0e2f', Converter={StaticResource TranslatedStringConverter}}" Style="{StaticResource SavefileInfo.Value}" VerticalAlignment="Top"/>

                    <ls:LSButton Grid.ColumnSpan="3" Grid.Row="6" x:Name="DeleteBtn"
                                HorizontalAlignment="Center"
                                Style="{StaticResource BigBrownButtonStyle}"
                                Content="{Binding Source='h4b0153e2g855bg45fag9e49g9c4ae03a648c', Converter={StaticResource TranslatedStringConverter}}"
                                Command="{Binding OpenMessageBox}"
                                CommandParameter="{DynamicResource MessageBoxSaveDelete}"
                                BoundEvent="UIDelete"
                                Margin="0,10,0,0"/>

                    <Image Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" x:Name="CloudIcon" Source="{StaticResource CloudImage}" Stretch="None" Margin="0,0,55,0"/>
                    <TextBlock Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" x:Name="CloudTitle" Text="{Binding Source='hc76b68d4g8daeg422eg80b2ge283aa2465d9', Converter={StaticResource TranslatedStringConverter}}" Style="{StaticResource SavefileInfo.Title}" FontSize="{StaticResource ScaledMediumFontSize}"/>
                    <TextBlock Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Right" x:Name="CloudSaveStatus" Text="{Binding Source='hb20007ddg7ba5g4432ga01eg42b1f30c0e2f', Converter={StaticResource TranslatedStringConverter}}" Style="{StaticResource SavefileInfo.Value}" VerticalAlignment="Top" Margin="0,0,5,0"/>


                    <StackPanel x:Name="VersionText" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="{StaticResource ScaledMediumFontSize}"/>
                                <Setter Property="Foreground" Value="{StaticResource LS_accent00TxtColor}"/>
                            </Style>
                        </StackPanel.Resources>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ParameterizedTranslatedStringConverter}">
                                        <Binding Source="hf5795482g056ag446fgb664gfe2b0007058e"/>
                                        <Binding Source="hbbc4fb50ga17ag467dgb3b8g8db652071022" Converter="{StaticResource TranslatedStringConverter}"/>
                                        <Binding Path="SelectedSave.Version" FallbackValue=""/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <TextBlock x:Name="ValiditySeparator" Text=" - " Visibility="{Binding Visibility, ElementName=InvalidTextReason}"/>
                            <TextBlock x:Name="InvalidTextReason" Text="" Visibility="Collapsed" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="SingleSaveDescription" Text="{Binding Source='hb276a3ccg5e63g47fag8820gb751dc159b4e', Converter={StaticResource TranslatedStringConverter}}" Visibility="Collapsed" Foreground="{StaticResource LS_warning50TxtColor}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ls:LSButton x:Name="DeleteDeprecatedDbg" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Style="{StaticResource DeleteDeprecatedButtonStyle}" Margin="0,0,0,0"/>
                </Grid>
            </Grid>

        </DockPanel>

        <ControlTemplate.Triggers>
            <!-- Triggers for CrossSave -->
            <DataTrigger Binding="{Binding SelectedSave.CrossStatus}" Value="NoCrossSync">
                <Setter TargetName="CrossIcon" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="CrossTitle" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="CrossSaveStatus" Property="Visibility" Value="Hidden"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.CrossStatus}" Value="InCrossSync">
                <Setter TargetName="CrossSaveStatus" Property="Foreground" Value="{StaticResource LS_accent75TxtColor}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.CrossStatus}" Value="Uploading">
                <Setter TargetName="CrossSaveStatus" Property="Foreground" Value="{StaticResource SaveLoad.Uploading}"/>
                <Setter TargetName="CrossSaveStatus" Property="Text" Value="{Binding Source='h36ab7cddg5320g4ba0ga3f5g84b0c69c25b5', Converter={StaticResource TranslatedStringConverter}}"/>
                <Setter TargetName="CrossIcon" Property="Source" Value="pack://application:,,,/Core;component/Assets/SaveLoad/ico_cross_save_uploading.png"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.CrossStatus}" Value="Downloading">
                <Setter TargetName="CrossSaveStatus" Property="Foreground" Value="{StaticResource SaveLoad.Downloading}"/>
                <Setter TargetName="CrossSaveStatus" Property="Text" Value="{Binding Source='hda248faeg2731g45a1g9687ga449aef4f1cf', Converter={StaticResource TranslatedStringConverter}}"/>
                <Setter TargetName="CrossIcon" Property="Source" Value="pack://application:,,,/Core;component/Assets/SaveLoad/ico_cross_save_downloading.png"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.CrossStatus}" Value="FailedUpload">
                <Setter TargetName="CrossSaveStatus" Property="Foreground" Value="{StaticResource SaveLoad.Uploading}"/>
                <Setter TargetName="CrossSaveStatus" Property="Text" Value="{Binding Source='hf86b04ffg9073g422egab1agdfbf61109ae2', Converter={StaticResource TranslatedStringConverter}}"/>
                <Setter TargetName="CrossIcon" Property="Source" Value="pack://application:,,,/Core;component/Assets/SaveLoad/ico_cross_save_uploading_issue.png"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.CrossStatus}" Value="FailedDownload">
                <Setter TargetName="CrossSaveStatus" Property="Foreground" Value="{StaticResource SaveLoad.Downloading}"/>
                <Setter TargetName="CrossSaveStatus" Property="Text" Value="{Binding Source='h3123b1adgf9cfg47b6gaf3fg8494b2353658', Converter={StaticResource TranslatedStringConverter}}"/>
                <Setter TargetName="CrossIcon" Property="Source" Value="pack://application:,,,/Core;component/Assets/SaveLoad/ico_cross_save_downloading_issue.png"/>
            </DataTrigger>

            <!-- Triggers for Cloud save -->
            <DataTrigger Binding="{Binding SelectedSave.CloudStatus}" Value="NoSync">
                <Setter TargetName="CloudIcon" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="CloudTitle" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="CloudSaveStatus" Property="Visibility" Value="Hidden"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.CloudStatus}" Value="InSync">
                <Setter TargetName="CloudSaveStatus" Property="Foreground" Value="{StaticResource LS_accent75TxtColor}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.CloudStatus}" Value="ToBeSynced">
                <Setter TargetName="CloudSaveStatus" Property="Foreground" Value="{StaticResource SaveLoad.Downloading}"/>
                <Setter TargetName="CloudSaveStatus" Property="Text" Value="{Binding Source='h3efe7ad3g38e4g4155g888dg642ed634e5b6', Converter={StaticResource TranslatedStringConverter}}"/>
            </DataTrigger>

            <!-- Triggers for save type -->
            <DataTrigger Binding="{Binding SelectedSave.Type}" Value="Quicksave">
                <Setter TargetName="SaveType" Property="Text" Value="{Binding Source='h07880ddcgf66eg4c24g9fd5g6ad2c8cf67c3', Converter={StaticResource TranslatedStringConverter}}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding SelectedSave.Type}" Value="Autosave">
                <Setter TargetName="SaveType" Property="Text" Value="{Binding Source='habeee505g3007g49cag8398gca3ebc53911b', Converter={StaticResource TranslatedStringConverter}}"/>
            </DataTrigger>

            <!-- Save validity -->
            <DataTrigger Binding="{Binding SelectedSave.Validity}" Value="TooOld">
                <Setter TargetName="InvalidTextReason" Property="Visibility" Value="Visible"/>
                <Setter TargetName="InvalidTextReason" Property="Text" Value="{Binding Source='h4cb97c56g2888g45c4g8b54ga92efe29d05f', Converter={StaticResource TranslatedStringConverter}}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.Validity}" Value="TooNew">
                <Setter TargetName="InvalidTextReason" Property="Visibility" Value="Visible"/>
                <Setter TargetName="InvalidTextReason" Property="Text" Value="{Binding Source='h1a72f51bg19b8g489cg875dg60e3ca119f57', Converter={StaticResource TranslatedStringConverter}}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.Validity}" Value="DataNotReady">
                <Setter TargetName="InvalidTextReason" Property="Visibility" Value="Visible"/>
                <Setter TargetName="InvalidTextReason" Property="Text" Value="{Binding Source='hbe37675cg33d5g4f00gbcf0gd82ef213b101', Converter={StaticResource TranslatedStringConverter}}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSave.Validity}" Value="LoadHonourModeWhilePlaying">
                <Setter TargetName="SingleSaveDescription" Property="Visibility" Value="Visible"/>
            </DataTrigger>
			<DataTrigger Binding="{Binding SelectedSave.Validity}" Value="ModdedCrossSaveConsole">
				<Setter TargetName="InvalidTextReason" Property="Visibility" Value="Visible"/>
				<Setter TargetName="InvalidTextReason" Property="Text" Value="{Binding Source='hfa5b8049g1dfag44f8g83e6gb65c58849d71', Converter={StaticResource TranslatedStringConverter}}"/>
			</DataTrigger>
		</ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>