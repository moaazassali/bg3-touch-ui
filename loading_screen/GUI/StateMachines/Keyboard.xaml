<ls:StateMachine xmlns:ls="clr-namespace:ls;assembly=Code"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ls:StateMachine.States>
        <!-- Taken from unpacked game file at Game\Public\Game\GUI\StateMachine.xaml -->

        <!--STATE: Loading-->
        <ls:State Name = "Loading" DisableStatesBelow = "True" Layout = "Common" Owner = "Player" ModType="Override">
            <ls:State.Widgets>
                <ls:StateWidget Filename="TouchUI_LoadingScreen.xaml" Layer="Default" BlockedLoading="True"/>
                <ls:StateWidget Filename="ScreenFade.xaml" Layer="ScreenFade" BlockedLoading="True"/>
            </ls:State.Widgets>
        </ls:State>

    </ls:StateMachine.States>
</ls:StateMachine>