                </ScrollViewer>

                <!-- Extract All Ingredients Button -->
                <ls:LSButton Grid.Row="2" x:Name="ExtractAllIngredients"
                                 HorizontalAlignment="Center"
                                 Style="{StaticResource BigBrownButtonStyle}"
