                            <ContentPresenter.Resources>
                                <BitmapImage x:Key="GroupIcon" UriSource="pack://application:,,,/Core;component/Assets/Tooltips/ItemIcons/Item_BASE_ALCH_Extract_Shadow_2.png"/>
                                <BitmapImage x:Key="GroupIcon_h" UriSource="pack://application:,,,/Core;component/Assets/Tooltips/ItemIcons/Item_BASE_ALCH_Extract_Shadow_2.png"/>
