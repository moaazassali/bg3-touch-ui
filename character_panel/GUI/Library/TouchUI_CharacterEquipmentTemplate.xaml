                                            <b:ConditionBehavior>
                                                <b:ConditionalExpression>
                                                    <b:ComparisonCondition LeftOperand="{Binding IsSelecting}" Operator="Equal" RightOperand="True"/>
                                                    <b:ComparisonCondition LeftOperand="{Binding DataContext.CurrentPlayer.UIData.DragData.DraggingGameObjects.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter='0', RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" Operator="Equal" RightOperand="False"/>
                                                </b:ConditionalExpression>
                                            </b:ConditionBehavior>
