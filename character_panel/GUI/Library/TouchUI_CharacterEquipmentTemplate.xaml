                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </b:ControlStoryboardAction.Storyboard>
                                        </b:ControlStoryboardAction>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </ls:LSButton>
                        </StackPanel>
                    </StackPanel>

                    <!--ArmorClass-->
                    <Control Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Template="{StaticResource TouchUI_ACHolder}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                </Grid>

                <Control Grid.Row="2" Template="{StaticResource TouchUI_WeaponAttackBonusTemplate}" VerticalAlignment="Bottom" Margin="0,8,0,0"/>

            </Grid>

            <!-- Touch UI - The engine context menu now opens in a popup anchored to the right edge of the window
                 with the item tooltip embedded beside the menu entries in the SAME popup
                 (TouchUI_ContextMenuWithTooltip), like the inventory slots. Selecting a slot opens it via
                 ShowContextMenuCommand (trigger at the top of this template). -->
            <ContentControl
                x:Name="EquipmentMenuAnchor"
                Template="{StaticResource TouchUI_ContextMenuWithTooltip}"
                Content="{Binding Path=DataContext.PlayerCharacterProperties.ActiveEquipmentSlot.Item, ElementName=CharacterPanelHolder}"
                ls:TooltipExtender.Owner="{Binding DataContext.CurrentPlayer.SelectedCharacter, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                ls:TooltipExtender.PlayerId="{Binding DataContext.CurrentPlayer.PlayerId, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                ls:TooltipExtender.Context="Equipment"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"/>
        </Grid>

        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding PlayerCharacterProperties.ArmorSetVisibility}" Value="Vanity">
                <Setter TargetName="VanityToggleHighlight" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>