                                <BitmapImage x:Key="Icon_Normal" UriSource="pack://application:,,,/Core;component/Assets/BottomBar/ico_journal_d.png" />
                                <BitmapImage x:Key="Icon_Hover" UriSource="pack://application:,,,/Core;component/Assets/BottomBar/ico_journal_h.png" />
                                <BitmapImage x:Key="Icon_Pressed" UriSource="pack://application:,,,/Core;component/Assets/BottomBar/ico_journal_d.png" />
                            </ls:LSButton.Resources>
