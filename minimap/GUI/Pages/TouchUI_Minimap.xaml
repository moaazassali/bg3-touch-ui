                        <!-- Touch UI - Moved to toggle menu down -->
                        <ls:LSButton Visibility="Collapsed" x:Name="PhotoModeBtn" Margin="183,0,0,-14" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
