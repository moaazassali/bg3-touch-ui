                                <BitmapImage x:Key="Icon_Hover" UriSource="pack://application:,,,/Core;component/Assets/Minimap/ico_photomode_h.png" />
                                <BitmapImage x:Key="Icon_Pressed" UriSource="pack://application:,,,/Core;component/Assets/Minimap/ico_photomode_d.png" />
                            </ls:LSButton.Resources>
                            <ls:LSButton.ToolTip>
                                <ls:LSTooltip>
                                    <TextBlock Text="{Binding Source='hef0689f9gb8c4g4e22g8637g60eb6c6b3750', Converter={StaticResource TranslatedStringConverter}}" Foreground="{StaticResource TooltipColor.Primary}"/>
                                </ls:LSTooltip>
                            </ls:LSButton.ToolTip>
                        </ls:LSButton>

                        <!-- Touch UI - Moved to toggle menu down -->
                        <ls:LSToggleButton Visibility="Collapsed" x:Name="PingButton" Margin="0,0,46,72" Command="{Binding Path=DataContext.RequestPingState, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Right" DataContext="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='Ping'}"
                                       ToolTipService.Placement="Top" ToolTipService.IsEnabled="True" ToolTipService.VerticalOffset="4">
                            <ls:LSToggleButton.ToolTip>
                                <ls:LSTooltip Content="{Binding ElementName=PingButton,Path=DataContext}"/>
                            </ls:LSToggleButton.ToolTip>
                            <ls:LSToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Image x:Name="bg" Source="{StaticResource mnmBtnNormal}" Stretch="None"/>
                                        <Image x:Name="img" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{StaticResource pingBtnNormal}"/>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Source" Value="{StaticResource mnmBtnHover}"/>
                                            <Setter TargetName="img" Property="Source" Value="{StaticResource pingBtnHover}"/>
                                        </Trigger>

                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bg" Property="Source" Value="{StaticResource mnmBtnHover}"/>
                                            <Setter TargetName="img" Property="Source" Value="{StaticResource pingBtnHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ls:LSToggleButton.Template>
                        </ls:LSToggleButton>

                        <!-- Touch UI - Not needed. We can just use journal button and then switch tabs or make a minimap click open the map. -->
                        <ls:LSButton Visibility="Collapsed" x:Name="MapBtn" Margin="0,0,120,18" VerticalAlignment="Bottom" HorizontalAlignment="Right" Template="{StaticResource PanelButtonWT}"
                                 Command="{Binding Path=DataContext.CustomEvent, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}"
                                 CommandParameter="ToggleJournalMap" DataContext="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='ToggleMap'}"
                                 BoundEvent="ToggleMap" SoundID="UI_HUD_Map">
                            <ls:LSButton.Resources>
                                <BitmapImage x:Key="Icon_Normal" UriSource="pack://application:,,,/Core;component/Assets/BottomBar/ico_map_d.png" />
                                <BitmapImage x:Key="Icon_Hover" UriSource="pack://application:,,,/Core;component/Assets/BottomBar/ico_map_h.png" />
                                <BitmapImage x:Key="Icon_Pressed" UriSource="pack://application:,,,/Core;component/Assets/BottomBar/ico_map_d.png" />
                            </ls:LSButton.Resources>
                        </ls:LSButton>

                    </Grid>

                    <!-- Touch UI - Moved outside from the minimap container grid  -->
                    <!-- Map Location Text -->
                    <ls:LSNineSliceImage x:Name="LocationHolder" Visibility="Hidden" ImageSource="{StaticResource MinimapLocationFrame}" Slices="50,26,180,26" Height="72" MinWidth="230" Padding="32,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ls:LSNineSliceImage.LayoutTransform>
                            <ScaleTransform ScaleX="2" ScaleY="2"/>
                        </ls:LSNineSliceImage.LayoutTransform>
                        <TextBlock Text="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.CurrentSubregionName}" 
                                    Foreground="{StaticResource LS_specialTxtColor}" FontSize="{StaticResource ScaledSmallFontSize}"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ls:LSNineSliceImage>

                    <!-- Touch UI - Similar style to the rest menu from TouchUI_HotBar.xaml -->
                    <Grid HorizontalAlignment="Right" Margin="0,0,36,0">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3"/>
                        </Grid.LayoutTransform>

                        <Grid.Resources>
                            <ControlTemplate x:Key="MenuToggleButtonTemplate" TargetType="ls:LSToggleButton">
                                <Grid Background="Transparent">
                                    <Image x:Name="ButtonBg" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_d.png" Stretch="None"/>

                                    <!-- Touch UI - LLM Generated - Spinning tail indicator for checked toggle button state -->
                                    <Grid x:Name="ActiveIndicator" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" Margin="0">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="IndicatorRotate" Angle="0"/>
                                        </Grid.RenderTransform>

                                        <!-- 1. The Fading Tail -->
                                        <Ellipse StrokeThickness="5" StrokeDashArray="25 100" StrokeDashCap="Round" Margin="7">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0.1"/>
                                                    <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                                                    <!-- Pulled white back slightly to ensure the dot blends well -->
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.95"/> 
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>
                                        </Ellipse>

                                        <!-- 2. The Solid Circular Head -->
                                        <Ellipse Width="5" Height="5" Fill="#FFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    </Grid>
                                    
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ButtonBg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_h.png"/>

                                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinAnimation">
                                                <Storyboard>
                                                    <DoubleAnimation 
                                                        Storyboard.TargetName="IndicatorRotate" 
                                                        Storyboard.TargetProperty="Angle" 
                                                        From="0" To="-360" 
                                                        Duration="0:0:2.0" 
                                                        RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinAnimation"/>
                                        </Trigger.ExitActions>

                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_p.png"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>

                            <ControlTemplate x:Key="MenuButtonTemplate" TargetType="ls:LSButton">
                                <Grid Background="Transparent">
                                    <Image x:Name="ButtonBg" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_d.png" Stretch="None"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="DimmingContainer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0" Fill="Black" Margin="5"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_p.png"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_disabled.png"/>
                                        <Setter TargetName="DimmingContainer" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>

                            <ControlTemplate x:Key="ActiveMenuButtonTemplate" TargetType="ls:LSButton">
                                <Grid Background="Transparent">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                    </Grid.LayoutTransform>
                                    <Image x:Name="ButtonBg" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_d.png" Stretch="None"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="DimmingContainer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0" Fill="Black" Margin="5"/>
                                    <!-- add an x popup to top right of icon -->
                                    <Image Source="pack://application:,,,/GustavNoesisGUI;component/Assets/Buttons/popin_closeIco_d.png" HorizontalAlignment="Right" VerticalAlignment="Top" Width="60" Margin="0,-10,-10,0"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_p.png"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_disabled.png"/>
                                        <Setter TargetName="DimmingContainer" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>

                            <!-- Touch UI - Taken from Game\Mods\MainUI\GUI\Pages\HotBar.xaml -->
                            <BitmapImage x:Key="IconRTNoArrow" UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/ico_RT_d_noArrow.png" />
                            <ControlTemplate x:Key="EnterFTBTemplate" TargetType="ls:LSButton">
                                <Grid>
                                    <Image x:Name="img" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_d.png" Stretch="None"/>
                                    <Grid>
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                        </Grid.LayoutTransform>
                                        <Image x:Name="ico" Source="{StaticResource IconHourglass}" Stretch="None" Visibility="Visible" Margin="0,0,0,0"/>
                                        <Grid x:Name="AnimChrono" Visibility="Hidden">
                                            <Image x:Name="icoAnim" Source="{StaticResource IconRTNoArrow}" Stretch="None" Margin="0,-4,0,0"/>
                                            <Path x:Name="Arrow" Stretch="None" Width="88" Height="88" StrokeThickness="0" Stroke="#88000000" Fill="White" RenderTransformOrigin="0.5,0.534">
                                                <Path.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform/>
                                                        <SkewTransform/>
                                                        <RotateTransform/>
                                                        <TranslateTransform/>
                                                    </TransformGroup>
                                                </Path.RenderTransform>
                                                <Path.Data>
                                                    <Geometry >M40,51 V45 L68,23 L47,51 Z</Geometry>
                                                </Path.Data>
                                            </Path>
                                        </Grid>
                                    </Grid>
                                    <Ellipse x:Name="DimmingContainer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0" Fill="Black" Margin="5"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Path=DataContext.CurrentPlayer.SelectedCharacter.InTurnBasedMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="img" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_p.png"/>
                                        <Setter TargetName="ico" Property="Margin" Value="0,0,0,0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="img" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_disabled.png"/>
                                        <Setter TargetName="DimmingContainer" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="ico" Property="Visibility" Value="Hidden"/>
                                        <Setter TargetName="AnimChrono" Property="Visibility" Value="Visible"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="ChronoAnim">
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AnimChrono" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0.5"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ChronoAnim"/>
                                        </Trigger.ExitActions>
                                    </Trigger>

                                    <DataTrigger Binding="{Binding Path=DataContext.CurrentPlayer.SelectedCharacter.InTurnBasedMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="FTBRotateAnim">
                                                <Storyboard>
                                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsEnabled)">
                                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0.0" Value="False"/>
                                                        <DiscreteBooleanKeyFrame KeyTime="{StaticResource TurnTime}" Value="True"/>
                                                    </BooleanAnimationUsingKeyFrames>

                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" >
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                        <LinearDoubleKeyFrame KeyTime="{StaticResource TurnTime}" Value="-360"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>

                                    <!-- When switching from a character in combat to a character in real-time, we don't want to have the 6s wait until entering FTB -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.CurrentPlayer.IsSelectingCharacter, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.CurrentPlayer.SelectedCharacter.InTurnBasedMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}" Value="False"/>
                                            <Condition Binding="{Binding DataContext.CurrentPlayer.PreviousSelectedCharacter.InTurnBasedMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="FTBRotateAnim"/>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <EventTrigger RoutedEvent="FrameworkElement.Unloaded">
                                        <StopStoryboard BeginStoryboardName="FTBStrokeAnim1"/>
                                        <StopStoryboard BeginStoryboardName="FTBRotateAnim"/>
                                        <StopStoryboard BeginStoryboardName="ChronoAnim"/>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Grid.Resources>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <!-- Touch UI - Add a panel to cancel some active button toggles from the popup menu -->
                            <StackPanel x:Name="MenuActiveToggles" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <!-- Touch UI - Only visible if popup menu is closed -->
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuButton}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Touch UI - Couldn't find a robust way to check for whether tooltips are active or not. Instead, we can track state locally with this -->
                                <CheckBox x:Name="ShowWorldTooltipsState" Visibility="Collapsed" IsChecked="False" IsHitTestVisible="False" Width="0" Height="0"/>

                                <ls:LSButton x:Name="ActiveMenuWorldTooltipsButton" Template="{StaticResource ActiveMenuButtonTemplate}">
                                    <Image Source="pack://application:,,,/Core;component/Assets/CharacterPanel/ico_search.png" Stretch="Uniform" Width="60" Margin="0,-5,-2,0"/> 
                                        <ls:LSButton.Style>
                                            <Style TargetType="ls:LSButton">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ShowWorldTooltipsState}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ls:LSButton.Style>

                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="Click">
                                                <b:ChangePropertyAction TargetName="ShowWorldTooltipsState" PropertyName="IsChecked" Value="False"/>
                                                <b:InvokeCommandAction Command="{Binding SetShowWorldTooltipsCommand}" CommandParameter="{StaticResource FalseValue}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                </ls:LSButton>

                                <!-- Touch UI - I couldn't find a direct way to figure out if the character is hiding, so I used this *hack* to give the ItemsControl some width if the character is sneaking -->
                                <ItemsControl x:Name="SneakScanner" 
                                            ItemsSource="{Binding CurrentPlayer.SelectedCharacter.StatusEffects}" 
                                            Opacity="0" 
                                            Height="0"
                                            IsHitTestVisible="False"
                                            Visibility="Hidden">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Touch UI - All status markers have 0px dimensions by default -->
                                            <Grid x:Name="StatusMarker" Height="0" Width="0"/>
                                            <DataTemplate.Triggers>
                                                <!-- Touch UI - If we find the SNEAKING status effect, then we give it some width which makes the ItemsControl have some width also instead of having 0px width -->
                                                <DataTrigger Binding="{Binding StatusId}" Value="SNEAKING">
                                                    <Setter TargetName="StatusMarker" Property="Width" Value="1"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ls:LSButton x:Name="ActiveMenuToggleGroupHideButton" Template="{StaticResource ActiveMenuButtonTemplate}"
                                    Command="{Binding DataContext.ToggleGroupHide, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                    BoundEvent="ToggleGroupStealth">
                                    <Image Source="pack://application:,,,/Core;component/Assets/PlayerPortraits/ico_party_hideAll_d.png" Stretch="Uniform" Width="50"/> 
                                    <ls:LSButton.Style>
                                        <Style TargetType="ls:LSButton">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualWidth, ElementName=SneakScanner, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ls:LSButton.Style>
                                </ls:LSButton>

                                <ls:LSButton x:Name="ActiveMenuPingButton" Template="{StaticResource ActiveMenuButtonTemplate}"
                                    Command="{Binding Path=DataContext.RequestPingState, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}">
                                    <Image Source="pack://application:,,,/Core;component/Assets/Minimap/ico_signal_d.png" Stretch="Uniform" Width="50"/> 
                                    <ls:LSButton.Style>
                                        <Style TargetType="ls:LSButton">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPlayer.IsRequestingPing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ls:LSButton.Style>
                                </ls:LSButton>
                            </StackPanel>

                            <ls:LSToggleButton x:Name="MenuButton" Template="{StaticResource MenuToggleButtonTemplate}">
                                <Image Source="pack://application:,,,/GustavNoesisGUI;component/Assets/Shared/ico_downArrow_d.png" Stretch="Uniform" Height="25" RenderTransformOrigin="0.5,0.5" Margin="0,6,6,0">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </Image.RenderTransform>
                                </Image>

                                <!-- Touch UI - Forces the menu open if a sub-item is showing a tutorial adapted from rest menu behavior in Game\Mods\MainUI\GUI\Pages\HotBar.xaml --> 
                                <ls:LSToggleButton.Style>
                                    <Style TargetType="ls:LSToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, ElementName=MenuLongRestItemButton}" Value="True">
                                                <Setter Property="IsChecked" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, ElementName=MenuShortRestItemButton}" Value="True">
                                                <Setter Property="IsChecked" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, ElementName=MenuTadpoleBtn}" Value="True">
                                                <Setter Property="IsChecked" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ls:LSToggleButton.Style>

                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Click">
                                        <ls:LSPlaySound Sound="UI_HUD_RestMenu_Open_Click"/>
                                    </b:EventTrigger>

                                    <!-- Touch UI - Tutorial trigger adapted from Game\Mods\MainUI\GUI\Pages\HotBar.xaml -->
                                    <b:PropertyChangedTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                        <b:Interaction.Behaviors>
                                            <b:ConditionBehavior>
                                                <b:ConditionalExpression>
                                                    <b:ComparisonCondition LeftOperand="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Operator="Equal" RightOperand="True"/>
                                                </b:ConditionalExpression>
                                            </b:ConditionBehavior>
                                        </b:Interaction.Behaviors>
                                        <!-- Tutorial UI Event - Rest Menu Opened-->
                                        <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}" CommandParameter="394c5454-28a2-433d-9dca-02a663e93cd1"/>
                                    </b:PropertyChangedTrigger>
                                </b:Interaction.Triggers>
                            </ls:LSToggleButton>
                        </StackPanel>

                        <Popup IsOpen="{Binding IsChecked, ElementName=MenuButton, Mode=TwoWay}"
                            PlacementTarget="{Binding ElementName=MenuButton}"
                            Placement="Relative"
                            StaysOpen="False"
                            AllowsTransparency="True"
                            PopupAnimation="Fade">
                            <WrapPanel Orientation="Vertical" FlowDirection="RightToLeft" Height="320" Margin="0,0,12,0">
                                <!-- Touch UI - We need this placeholder for the first button location to overlap the menu toggle button so that we can have a wrap panel that places icons to left of toggle button as well and not just directly under. This is why Popup placement is relative.-->
                                <ls:LSButton>
                                     <ls:LSButton.Template>
                                        <ControlTemplate TargetType="ls:LSButton">
                                            <Grid Background="Transparent">
                                                <Image x:Name="ButtonBg" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_h.png" Stretch="None"/>
                                                <Image Source="pack://application:,,,/GustavNoesisGUI;component/Assets/Shared/ico_downArrow_d.png" Stretch="Uniform" Height="25" RenderTransformOrigin="0.5,0.5" Margin="6,6,0,0">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="-45"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_p.png"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ls:LSButton.Template>
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                            <ls:LSPlaySound Sound="UI_HUD_RestMenu_Open_Click"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <ls:LSButton Template="{StaticResource MenuButtonTemplate}"
                                    DataContext="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='ToggleInGameMenu'}"
                                    Command="{Binding Path=DataContext.CustomEvent, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}" CommandParameter="ToggleGameMenu"
                                    SoundID="UI_HUD_EscapeMenu" IsEnabled="{Binding DataContext.CurrentPlayer.UIData.IsGameMenuAllowed, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}">
                                    <Image Source="pack://application:,,,/Core;component/Assets/BottomBar/ico_menu_d.png" Stretch="Uniform" Width="50"/> 
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <ls:LSButton Template="{StaticResource MenuButtonTemplate}"
                                             Command="{Binding Path=DataContext.CustomEvent, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}"
                                             CommandParameter="ToggleJournalQuests" DataContext="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='ToggleJournal'}"
                                             SoundID="UI_HUD_Journal" BoundEvent="ToggleJournal">
                                    <Image Source="pack://application:,,,/Core;component/Assets/BottomBar/ico_journal_d.png" Stretch="Uniform" Width="50"/> 
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <ls:LSButton Template="{StaticResource MenuButtonTemplate}"
                                     Command="{Binding Path=DataContext.TogglePhotoModeCommand, ElementName=Minimap}" 
                                     CommandParameter="{StaticResource TrueValue}" 
                                     DataContext="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='UITogglePhotoMode'}"
                                     IsEnabled="{Binding DataContext.CurrentPlayer.IsHost, ElementName=Minimap}"
                                     SoundID="UI_HUD_Journal"
                                     BoundEvent="UITogglePhotoMode">
                                    <Grid>
                                        <Image Source="pack://application:,,,/Core;component/Assets/Minimap/ico_photomode_d.png" Stretch="Uniform" Width="50"/> 
                                        <!-- Touch UI - LLM Generated - Lens effect in center of camera icon because the existing camera hole is just a black hole, and it looks strange now with the 3x scale -->
                                        <Grid Width="18" Height="18" Margin="0,1,0,0"> 
                                            <Grid.Effect>
                                                <BlurEffect Radius="1.2"/>
                                            </Grid.Effect>
                                            <!-- 1. Metallic Rim (Hides the black border) -->
                                            <Ellipse StrokeThickness="1">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#EBC48E" Offset="0"/> <!-- Light Gold -->
                                                        <GradientStop Color="#63391B" Offset="1"/> <!-- Dark Bronze -->
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                                <Ellipse.Fill>
                                                    <!-- Deep Lens Base -->
                                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                        <GradientStop Color="#1A2030" Offset="0"/>
                                                        <GradientStop Color="#1c1e24" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- 2. Inner "Glass" Reflection -->
                                            <Ellipse Margin="3" Opacity="0.5">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush Center="0.5,0.8" RadiusX="0.8" RadiusY="0.8">
                                                        <GradientStop Color="#5CA7FF" Offset="0"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- 3. The Glint (Primary highlight) -->
                                            <Ellipse Width="5" Height="3.5" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                    Margin="5,4,0,0" Opacity="0.9">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="White" Offset="0"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="-30"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <ls:LSToggleButton x:Name="MenuPingButton" Template="{StaticResource MenuToggleButtonTemplate}"
                                    Command="{Binding Path=DataContext.RequestPingState, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}">
                                    <Image Source="pack://application:,,,/Core;component/Assets/Minimap/ico_signal_d.png" Stretch="Uniform" Width="50"/> 
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSToggleButton>

                                <!-- Touch UI - Adapted from Game\Mods\MainUI\GUI\Pages\PlayerPortraits.xaml -->
                                <ls:LSToggleButton x:Name="MenuToggleGroupHideButton" Template="{StaticResource MenuToggleButtonTemplate}"
                                    Command="{Binding DataContext.ToggleGroupHide, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                    BoundEvent="ToggleGroupStealth">
                                    <Image Source="pack://application:,,,/Core;component/Assets/PlayerPortraits/ico_party_hideAll_d.png" Stretch="Uniform" Width="50"/> 
                                    <ls:LSToggleButton.Style>
                                        <Style TargetType="ls:LSToggleButton">
                                            <Setter Property="IsChecked" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualWidth, ElementName=SneakScanner, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True">
                                                    <Setter Property="IsChecked" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ls:LSToggleButton.Style>
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSToggleButton>

                                <!-- Touch UI - Adapted from Game\Mods\MainUI\GUI\Pages\HotBar.xaml -->
                                <ls:LSButton Template="{StaticResource MenuButtonTemplate}"
                                    Command="{Binding CustomEvent}" CommandParameter="ToggleCharacterPanel">
                                    <Image Source="pack://application:,,,/Core;component/Assets/BottomBar/ico_equipment_d.png" Stretch="Uniform" Width="50"/> 
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <ls:LSButton x:Name="MenuTadpoleBtn" Command="{Binding CustomEvent}" CommandParameter="OpenTadpoleTree" SoundID="UI_HUD_EscapeMenu" ls:TutorialProperties.TargetID="TUT_TadpoleTree" ls:TutorialProperties.ModalType="TopRight" Visibility="Collapsed">
                                    <ls:LSButton.Template>
                                        <ControlTemplate TargetType="ls:LSButton">
                                            <ControlTemplate.Resources>
                                                <BitmapImage x:Key="BtnTadpoleEmpty" UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_d.png"/>
                                                <BitmapImage x:Key="IcoTadpoleGold" UriSource="pack://application:,,,/Core;component/Assets/TadpoleTree/ICO_TadpoleGold.png"/>
                                                <BitmapImage x:Key="BtnTadpoleCounter" UriSource="pack://application:,,,/Core;component/Assets/TadpoleTree/Btn_TadpoleCounter.png"/>
                                            </ControlTemplate.Resources>
                                            <Grid x:Name="BtnRoot">
                                                <Image x:Name="Bg" Source="{StaticResource BtnTadpoleEmpty}" Stretch="None"/>

                                                <Image x:Name="TadpoleIcon" Source="{StaticResource IcoTadpoleGold}" Stretch="Uniform" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="TadpoleScale" ScaleX="1" ScaleY="1"/>
                                                        </TransformGroup>
                                                    </Image.RenderTransform>
                                                </Image>
                                                <!-- Touch UI - TadpoleIcon is too shiny and doesn't match other icons that well, so we can try to dim it -->
                                                <Ellipse x:Name="TadpoleIconDimmingContainer" Opacity="0.5" Fill="#6e5436" Margin="0" Width="60">
                                                    <Ellipse.LayoutTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="-1"/>
                                                        </TransformGroup>
                                                    </Ellipse.LayoutTransform>
                                                    <Ellipse.OpacityMask>
                                                        <ImageBrush ImageSource="{StaticResource IcoTadpoleGold}" Stretch="Uniform"/>
                                                    </Ellipse.OpacityMask>
                                                </Ellipse>

                                                <Grid x:Name="HudTadpoleCount" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="60" Margin="-8,-8,0,0" Visibility="Collapsed">
                                                    <Grid.LayoutTransform>
                                                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                                    </Grid.LayoutTransform>
                                                    <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" Source="{StaticResource BtnTadpoleCounter}"></Image>
                                                    <TextBlock x:Name="TadpoleCount" Text="{Binding CurrentPlayer.PartyTadpoleCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource ScaledMediumFontSize}" Margin="0,2,2,0"/>
                                                </Grid>

                                                <Ellipse x:Name="DimmingContainer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0" Fill="Black" Margin="5"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_p.png" TargetName="Bg"/>
                                                    <Setter TargetName="TadpoleIcon" Property="Margin" Value="0,4,0,0" />
                                                    <Setter TargetName="TadpoleIconDimmingContainer" Property="Margin" Value="0,4,0,0" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Source" Value="pack://application:,,,/Core;component/Assets/TadpoleTree/BTN_TadpoleEmpty_disabled.png" TargetName="Bg"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bg" Property="Source" Value="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/btn_pop_disabled.png"/>
                                                    <Setter TargetName="DimmingContainer" Property="Opacity" Value="0.5"/>
                                                </Trigger>

                                                <DataTrigger Binding="{Binding CurrentPlayer.PartyTadpoleCount, Converter={StaticResource GreaterThanConverter}, ConverterParameter='0'}" Value="True">
                                                    <!-- <Setter Property="Source" Value="pack://application:,,,/Core;component/Assets/TadpoleTree/BTN_TadpolePopulated_d.png" TargetName="Bg"/> -->
                                                    <!-- <Setter TargetName="TadpoleIcon" Property="Visibility" Value="Visible"/> -->
                                                    <Setter TargetName="TadpoleIconDimmingContainer" Property="Opacity" Value="0"/>
                                                    <Setter TargetName="HudTadpoleCount" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <!-- Touch UI - Forces the menu open if a sub-item is showing a tutorial --> 
                                                <DataTrigger Binding="{Binding (ls:TutorialProperties.IsShowingTutorial), RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Tag" Value="True"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ls:LSButton.Template>
                                </ls:LSButton>

                                <!-- Touch UI - Taken from TouchUI_Hotbar.xaml -->
                                <ls:LSButton x:Name="MenuEnterFTBButton" Template="{StaticResource EnterFTBTemplate}"
                                    Command="{Binding Path=DataContext.ToggleTurnBasedMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ls:UIWidget}}}"
                                    DataContext="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='UIEnterTurnBased'}"
                                    BoundEvent="UIEnterTurnBased"
                                    SoundID="UI_HUD_Hotbar_EnterFTB"
                                    ls:TutorialProperties.TargetID="TUT_FTB" ls:TutorialProperties.ModalType="Bottom" ls:TutorialProperties.Padding="10">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <!-- Touch UI - Taken from TouchUI_Hotbar.xaml -->
                                <ls:LSButton x:Name="MenuGoToCampButton" Template="{StaticResource MenuButtonTemplate}" Command="{Binding GoToCamp}" IsEnabled="False">
                                    <Image Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/ico_camp_h.png" Stretch="Uniform" Width="45"/>
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                        <b:EventTrigger EventName="MouseDown">
                                            <ls:LSPlaySound Sound="UI_HUD_Party_Campsite_Confirm_Click"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <!-- Touch UI - Taken from TouchUI_Hotbar.xaml -->
                                <!-- Target for 2 tutorials (one attached to the MenuItem, the other to the inner Grid) -->
                                <!-- Tag is used to expose if this subitem is showing any tutorial -->
                                <!-- We need to manually reflect IsAnimating since inheritance is somehow broken and it doesn't reach this point -->
                                <ls:LSButton x:Name="MenuLongRestItemButton" Template="{StaticResource MenuButtonTemplate}"
                                    Command="{Binding CampTravel}"
                                    ls:TutorialProperties.TargetID="TUT_LongRest"
                                    ls:TutorialProperties.ModalType="RightBottom"
                                    ls:TutorialProperties.IsAnimating="{Binding (ls:TutorialProperties.IsAnimating), RelativeSource={RelativeSource AncestorType={x:Type ItemsPresenter}}}">
                                    <Grid x:Name="LongRestGrid" ls:TutorialProperties.TargetID="TUT_Camp" ls:TutorialProperties.ModalType="RightBottom">
                                        <Image x:Name="icon" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/ico_longRest_h.png" Stretch="Uniform" Width="80"/>
                                    </Grid>
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                        <b:EventTrigger EventName="MouseDown">
                                            <ls:LSPlaySound Sound="UI_HUD_Party_Campsite"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>

                                    <ls:LSButton.Style>
                                        <Style TargetType="ls:LSButton" BasedOn="{StaticResource {x:Type ls:LSButton}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding (ls:TutorialProperties.IsShowingTutorial), RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Tag" Value="True"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding (ls:TutorialProperties.IsShowingTutorial), ElementName=LongRestGrid}" Value="True">
                                                    <Setter Property="Tag" Value="True"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding CurrentPlayer.EndTheDayState}" Value="Disabled">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentPlayer.EndTheDayState}" Value="Unavailable">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ls:LSButton.Style>
                                </ls:LSButton>

                                <!-- Touch UI - Taken from TouchUI_Hotbar.xaml -->
                                <!-- Target for 2 tutorials (one attached to the MenuItem, the other to the inner Grid) -->
                                <!-- Tag is used to expose if this subitem is showing any tutorial -->
                                <!-- We need to manually reflect IsAnimating since inheritance is somehow broken and it doesn't reach this point -->
                                <ls:LSButton x:Name="MenuShortRestItemButton" Template="{StaticResource MenuButtonTemplate}"
                                    Command="{Binding ShortRest}"
                                    IsEnabled="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.IsShortRestAvailable}"
                                    ls:TutorialProperties.TargetID="TUT_ShortRestDowned"
                                    ls:TutorialProperties.ModalType="RightBottom"
                                    ls:TutorialProperties.IsAnimating="{Binding (ls:TutorialProperties.IsAnimating), RelativeSource={RelativeSource AncestorType={x:Type ItemsPresenter}}}">
                                        <Grid x:Name="ShortRestGrid" ls:TutorialProperties.TargetID="TUT_ShortRest" ls:TutorialProperties.ModalType="RightBottom" Margin="0,10,0,0">
                                            <Image x:Name="ico" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/ico_shortRest_h.png" Stretch="Uniform" Width="60"/>
                                            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" Margin="12,22,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image x:Name="dot1" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/ico_shortRest_node.png" Stretch="Uniform" Width="30" Margin="0,0,-14,0">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.Stats.ShortRestPointsResource.Value}" Value="0">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Image x:Name="dot2" Source="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/ico_shortRest_node.png" Stretch="Uniform" Width="30" Margin="0,0,14,0">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.Stats.ShortRestPointsResource.Value}" Value="0">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.Stats.ShortRestPointsResource.Value}" Value="1">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </StackPanel>

                                            <b:Interaction.Triggers>
                                                <b:EventTrigger EventName="MouseUp">
                                                    <ls:LSPlaySound Sound="UI_HUD_ShortRest_Click"/>
                                                </b:EventTrigger>
                                            </b:Interaction.Triggers>
                                        </Grid>

                                        <ls:LSButton.Style>
                                            <Style TargetType="ls:LSButton" BasedOn="{StaticResource {x:Type ls:LSButton}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding (ls:TutorialProperties.IsShowingTutorial), RelativeSource={RelativeSource Mode=Self}}" Value="True">
                                                        <Setter Property="Tag" Value="True"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding (ls:TutorialProperties.IsShowingTutorial), ElementName=ShortRestGrid}" Value="True">
                                                        <Setter Property="Tag" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ls:LSButton.Style>

                                        <b:Interaction.Behaviors>
                                            <ls:RuleSetModifierValueBehavior x:Name="ShortRestFullyHealsModifier" Modifiers="{Binding DataContext.Data.CurrentRuleSetModifiers, ElementName=HotBar}" ModifierName="SHORT_REST_FULLY_HEALS"/>
                                        </b:Interaction.Behaviors>
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="Click">
                                                <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                </ls:LSButton>

                                <ls:LSButton Template="{StaticResource MenuButtonTemplate}"
                                    Command="{Binding DataContext.SetCameraOnGameObject,RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                    CommandParameter="{Binding CurrentPlayer.SelectedCharacter}">
                                    <Image Source="pack://application:,,,/Core;component/Assets/Minimap/ico_centerCam_d.png" Stretch="Uniform" Width="45"/> 
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Click">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSButton>

                                <ls:LSToggleButton x:Name="MenuWorldTooltipsButton" Template="{StaticResource MenuToggleButtonTemplate}"
                                    IsChecked="{Binding IsChecked, ElementName=ShowWorldTooltipsState, Mode=TwoWay}">
                                    <Image Source="pack://application:,,,/Core;component/Assets/CharacterPanel/ico_search.png" Stretch="Uniform" Width="60" Margin="0,-5,-2,0"/> 
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="Checked">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                            <b:InvokeCommandAction Command="{Binding SetShowWorldTooltipsCommand}" CommandParameter="{StaticResource TrueValue}"/>
                                        </b:EventTrigger>
                                        <b:EventTrigger EventName="Unchecked">
                                            <b:ChangePropertyAction TargetName="MenuButton" PropertyName="IsChecked" Value="False"/>
                                            <b:InvokeCommandAction Command="{Binding SetShowWorldTooltipsCommand}" CommandParameter="{StaticResource FalseValue}"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSToggleButton>
                            </WrapPanel>
                        </Popup>
                    </Grid>

                    <ContentPresenter x:Name="StoryTimer" HorizontalAlignment="Right" Margin="0,6,0,0" Content="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.StoryTimer}" Visibility="Collapsed" Style="{StaticResource StoryTimerStyle}"/>

                    <StackPanel x:Name="DebugInfo" Panel.ZIndex="2" Margin="0,28,30,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding Data.IsGold, Converter={StaticResource BoolToCollapsedConverter}}">

                        <!-- Additional debug info -->
                        <TextBlock Foreground="{StaticResource LS_specialTxtColor}" TextAlignment="Right" noesis:Text.Stroke="Black" noesis:Text.StrokeThickness="6">
                            <Run Text="Live UI -"/>
                            <Run Text="{Binding Data.DebugData.BuildType}"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource LS_specialTxtColor}" TextAlignment="Right" noesis:Text.Stroke="Black" noesis:Text.StrokeThickness="6">
                            <Run Text="{Binding Data.DebugData.MainModName, StringFormat=' {0} -'}"/>
                            <Run Text="{Binding Data.DebugData.CurrentLevelName}"/>
                        </TextBlock>

                        <!-- Active rulesets -->
                        <ItemsControl ItemsSource="{Binding Data.DebugData.ActiveRulesets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Line}" Foreground="{StaticResource LS_baseTxtColor}" TextAlignment="Right" noesis:Text.Stroke="Black" noesis:Text.StrokeThickness="6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- EA text + version -->
                        <TextBlock Foreground="{StaticResource LS_specialTxtColor}" Text="{Binding Data.VersionString}" Panel.ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Right" noesis:Text.Stroke="Black" noesis:Text.StrokeThickness="6"/>
                    </StackPanel>

                    <ItemsControl x:Name="NotificationsContainer" ItemsSource="{Binding CurrentPlayer.UIData.TutorialNotifications}"
                              AlternationCount="{Binding CurrentPlayer.UIData.TutorialNotifications.Count}" VerticalAlignment="Top"
                              HorizontalAlignment="Right" Width="800" ItemTemplate="{StaticResource TutorialNotification}"
                              MaxHeight="945" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Touch UI - Taken from Game\Mods\MainUI\GUI\Pages\PlayerPortraits.xaml -->
                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.CharacterMode}" Value="InCombat">
                    <Setter TargetName="MenuToggleGroupHideButton" Property="IsEnabled" Value="False"/>
                </DataTrigger>

                <!-- Touch UI - Taken from Game\Mods\MainUI\GUI\Pages\PlayerPortraits.xaml -->
                <DataTrigger Binding="{Binding CurrentPlayer.UIData.InPlayerPanels}" Value="True">
                    <Setter TargetName="MenuToggleGroupHideButton" Property="IsEnabled" Value="False"/>
                </DataTrigger>

                <!-- Touch UI - Taken from Game\Mods\MainUI\GUI\Pages\HotBar.xaml -->
                <DataTrigger Binding="{Binding CurrentPlayer.TravelError}" Value="None">
                    <Setter TargetName="MenuGoToCampButton" Property="IsEnabled" Value="True"/>
                </DataTrigger>

                <!-- Touch UI - Adapted from visibility behavior of rest menu in Game\Mods\MainUI\GUI\Pages\HotBar.xaml -->
                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.InTurnBasedMode}" Value="True">
                    <Setter TargetName="MenuEnterFTBButton" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="MenuGoToCampButton" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="MenuLongRestItemButton" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="MenuShortRestItemButton" Property="IsEnabled" Value="False"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.IsRequestingPing}" Value="False">
                    <Setter TargetName="PingButton" Property="IsChecked" Value="False"></Setter>
                    <Setter TargetName="MenuPingButton" Property="IsChecked" Value="False"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPlayer.IsRequestingPing}" Value="True">
                    <Setter TargetName="PingButton" Property="IsChecked" Value="True"></Setter>
                    <Setter TargetName="MenuPingButton" Property="IsChecked" Value="True"></Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.StoryTimer, Converter={StaticResource NullToBoolFalseConverter}}" Value="True">
                    <Setter TargetName="StoryTimer" Property="Visibility" Value="Visible"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPlayer.PartyUnlockedTadpolePowers}" Value="True">
                    <!-- <Setter TargetName="TadpoleBtn" Property="Visibility" Value="Visible"/> -->
                    <Setter TargetName="MenuTadpoleBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPlayer.UIData.CombatLogSize}" Value="Expanded">
                    <Setter TargetName="NotificationsContainer" Property="MaxHeight" Value="840"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPlayer.UIData.CombatLogSize}" Value="SuperExpanded">
                    <Setter TargetName="NotificationsContainer" Property="MaxHeight" Value="420"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.UIData.PreviousState}" Value="PartyInventory">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard  Storyboard="{StaticResource Hud.AnimIn}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.UIData.PreviousState}" Value="PartyEquipment">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard  Storyboard="{StaticResource Hud.AnimIn}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPlayer.UIData.PreviousState}" Value="Dialogue">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard  Storyboard="{StaticResource Hud.AnimIn}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPlayer.UIData.PreviousState}" Value="PartyCharacterSheet">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard  Storyboard="{StaticResource Hud.AnimIn}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPlayer.UIData.PreviousState}" Value="SpellBook">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard  Storyboard="{StaticResource Hud.AnimIn}" />
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.UIData.InPlayerPanels}" Value="True">
                    <Setter TargetName="MinimapContainer" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.IsInDangerZone}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="DangerZoneGlowAnimation">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DangerZoneGlowAnimated" Storyboard.TargetProperty="(UIElement.Opacity)" AutoReverse="True">
                                    <EasingDoubleKeyFrame Value="0.6" KeyTime="0:0:0">
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame Value="0.1" KeyTime="0:0:4">
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="DangerZoneGlowAnimation"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.CurrentSubregionName, Converter={StaticResource NullToBoolFalseConverter}}" Value="True"/>
                        <Condition Binding="{Binding CurrentPlayer.SelectedCharacter.InTurnBasedMode}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <!-- <Setter TargetName="MapBorder" Property="Source" Value="{StaticResource MinimapBgLocation}"/> -->
                    <Setter TargetName="LocationHolder" Property="Visibility" Value="Visible"/>
                    <!-- <Setter TargetName="TadpoleBtn" Property="Margin" Value="-100,100,0,0"/> -->
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ls:UIWidget.ContentTemplate>
</ls:UIWidget>
